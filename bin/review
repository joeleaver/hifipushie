#!/usr/bin/env python3
"""review: a blind, independent art-director review of reference | result pairs (docs/notes/gates.md, LOOK).
Agents run this on their OWN work every round and keep iterating until it passes; only then does a sheet go
to the coordinator. The reviewer sees only the images and neutral item names: no captions, numbers or claims.

  review <out_dir> <item>=<reference.png>:<result.png> [...] [--context "what this is"] [--dry]
         [--stage "<what this stage owns>"] [--not "<what other stages own>"]

  item      a checklist region name, e.g. "sweater armhole, front" or "crease, right eye" (names only, no values)
  context   ONE neutral line: what kind of thing is shown (e.g. "a game character's knit sweater, simulated").
            Never your claims, numbers or what you changed.
  stage     what THIS review judges, e.g. "skin: colour, surface, paint, eyes' materials". Faults outside it are listed
            separately under OTHER STAGES and don't affect the verdict (pass them to their owner).
  not       what belongs to other stages, e.g. "head shape and proportions; hair".
Writes <out_dir>/pair_<n>.png (reference left, result right) and <out_dir>/review.md; prints the review.
Last line is "VERDICT: PASS" or "VERDICT: FAIL". Exit 0 = PASS, 3 = FAIL, 4 = the review did not run
(never count that as 0 MAJORs), 5 = input refused (a caption, a sheet, a number or claim in the text).
Crops must already frame the region (same framing on both sides); big sheets with captions are refused.
"""
import os, subprocess, sys
from PIL import Image, ImageDraw

args = sys.argv[1:]
if len(args) < 2 or args[0] in ("-h", "--help"):
    print(__doc__); sys.exit(2)
def opt(name):
    if name in args:
        i = args.index(name); v = args[i + 1]; del args[i:i + 2]; return v
    return ""
ctx, stage, other = opt("--context"), opt("--stage"), opt("--not")
DRY = "--dry" in args
if DRY: args.remove("--dry")
out = os.path.abspath(args[0]); os.makedirs(out, exist_ok=True)
# Input gate (hifipushie/reviewgate.py, codified 2026-10-19): captioned or sheet-sized images and numbers / claims in
# the names or --context are refused, exit 5. The code lives in the repo (main checkout), tested there.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))  # this checkout's src
try:
    from hifipushie import reviewgate
except ImportError as e:
    print(f"REFUSED: review input gate unavailable ({e})", file=sys.stderr); sys.exit(5)
if reviewgate is not None:
    _it = [a.partition("=") for a in args[1:]]
    try:
        reviewgate.refuse_inputs([p for _, _, pr in _it for p in pr.split(":") if p], [n for n, _, _ in _it], ctx)
    except reviewgate.InputRefused as e:
        print(e, file=sys.stderr); sys.exit(5)
items = []
for n, a in enumerate(args[1:]):
    name, _, pair = a.partition("=")
    ref, _, res = pair.partition(":")
    if not (name and ref and res): sys.exit(f"bad pair: {a}")
    A, B = Image.open(ref).convert("RGB"), Image.open(res).convert("RGB")
    h = min(900, max(A.height, B.height))
    A = A.resize((max(1, A.width * h // A.height), h)); B = B.resize((max(1, B.width * h // B.height), h))
    W = A.width + B.width + 12
    if W > 1800:
        s = 1800 / W; A = A.resize((int(A.width * s), int(h * s))); B = B.resize((int(B.width * s), int(h * s))); h = A.height
    im = Image.new("RGB", (A.width + B.width + 12, h + 22), (30, 30, 30))
    im.paste(A, (0, 22)); im.paste(B, (A.width + 12, 22))
    d = ImageDraw.Draw(im); d.text((4, 4), "REFERENCE", fill=(255, 255, 255)); d.text((A.width + 16, 4), "RESULT", fill=(255, 255, 255))
    p = os.path.join(out, f"pair_{n}.png"); im.save(p); items.append((name, p))

scope = ""
if stage:
    scope = (f"This review judges ONLY this stage: {stage}." + (f" These belong to OTHER stages: {other}." if other else "")
             + " List faults outside this stage at the end under a heading 'OTHER STAGES' (same MAJOR/MINOR marking);"
             " they do NOT count toward the verdict. Don't excuse an in-stage fault by blaming another stage.\n")
listing = "\n".join(f"- {name}: {p}" for name, p in items)
prompt = f"""You are a senior art director at a game studio reviewing work against its reference. You have no stake in it.
{('What is shown: ' + ctx) if ctx else ''}
Each image below is one region: REFERENCE on the left, RESULT on the right, same framing. Read every image with the Read tool.
{listing}

For each region, list everything about the RESULT that reads wrong against the REFERENCE: worst first, concretely (where, what,
how far off, e.g. "the sleeve seam runs down the side to the hem; in the reference the underarm is just below the armpit").
Judge construction and form first, then material and surface, then colour. A clean, artifact-free result that isn't the reference
is still wrong. Don't praise. Don't guess at causes or fixes beyond one short "needs:" line per fault. Say if a crop is too small or
too blurry to judge. Mark each fault MAJOR (a viewer would notice at game distance or it changes what the thing is) or MINOR.
{scope}End with exactly one line: "VERDICT: PASS" only if there is no MAJOR fault in any region, otherwise "VERDICT: FAIL"."""
# A bare `claude -p` loads the user's whole setup (MCP servers, CLAUDE.md, memory: ~210k tokens per call, measured
# 2026-10-15 by the audit agent); the reviewer needs only Read on its pair images.
if DRY:  # (Joe 2026-10-19) fallback when the CLI is refused: a fresh subagent gets ONE image per message
    open(os.path.join(out, "prompt.md"), "w").write(prompt + "\n\nFALLBACK REVIEW: give the reviewer ONE pair image per "
        "message, in the listed order; never a contact sheet. Collect its per-region lines, then the final line(s).\n")
    print(f"DRY: {out}/prompt.md + {len(items)} images (one per reviewer turn)"); sys.exit(0)
r = subprocess.run(["claude", "-p", prompt, "--allowedTools", "Read", "--tools", "Read", "--add-dir", out,
                    "--no-session-persistence", "--strict-mcp-config", "--setting-sources", "",
                    "--system-prompt", "You are a senior art director reviewing renders against references. You have no "
                    "stake in this work.", "--output-format", "text"], cwd=out, capture_output=True, text=True, timeout=900)
text = (r.stdout or "") + (("\n[stderr] " + r.stderr[-500:]) if r.returncode else "")
open(os.path.join(out, "review.md"), "w").write(text)
print(text)
last = [l for l in text.strip().splitlines() if l.strip()][-1:] or [""]
# No VERDICT line = the review did not run (CLI refused: usage limit, auth, timeout). Exit 4 and mark the file, so
# downstream counts (gameclass) report REVIEW FAILED instead of 0 MAJORs (skin r8, 2026-10-18: four heads read as 0).
if r.returncode or "VERDICT:" not in last[0]:
    open(os.path.join(out, "review.md"), "w").write("REVIEW FAILED (no VERDICT line; claude exit %d)\n%s" % (r.returncode, text))
    sys.exit(4)
sys.exit(0 if "VERDICT: PASS" in last[0] else 3)
