#!/usr/bin/env python3
"""review-ab: a blind side-by-side review of two candidates against the reference (docs/notes/gates.md, LOOK).
Use it to decide whether a change is kept: one sitting, same reviewer, both versions on the same tiles, so the
answer doesn't depend on which reviewer you got (separate one-result reviews of the same build varied 2 -> 5 MAJORs).

  review-ab <out_dir> <item>=<reference.png>:<old.png>:<new.png> [...] [--context "what this is"] [--dry]
            [--stage "<what this stage owns>"] [--not "<what other stages own>"]

Per item the two candidates are placed as X / Y in a random order (key in <out_dir>/key.json, never shown to the
reviewer). Writes <out_dir>/trio_<n>.png and review.md; prints the review with the key applied. Last line:
"VERDICT: NEW" (new closer overall), "VERDICT: OLD" or "VERDICT: TIE". Exit 0 = NEW, 3 = OLD / TIE, 4 = didn't run, 5 = input refused (caption / sheet / claim).
"""
import json, os, random, re, subprocess, sys
from PIL import Image, ImageDraw

args = sys.argv[1:]
if len(args) < 2 or args[0] in ("-h", "--help"):
    print(__doc__); sys.exit(2)
def opt(name):
    if name in args:
        i = args.index(name); v = args[i + 1]; del args[i:i + 2]; return v
    return ""
ctx, stage, other = opt("--context"), opt("--stage"), opt("--not")
DRY = "--dry" in args
if DRY: args.remove("--dry")
out = os.path.abspath(args[0]); os.makedirs(out, exist_ok=True)
# Input gate (hifipushie/reviewgate.py, codified 2026-10-19): captioned or sheet-sized images and numbers / claims in
# the names or --context are refused, exit 5. The code lives in the repo (main checkout), tested there.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))  # this checkout's src
try:
    from hifipushie import reviewgate
except ImportError as e:
    print(f"REFUSED: review input gate unavailable ({e})", file=sys.stderr); sys.exit(5)
if reviewgate is not None:
    _it = [a.partition("=") for a in args[1:]]
    try:
        reviewgate.refuse_inputs([p for _, _, pr in _it for p in pr.split(":") if p], [n for n, _, _ in _it], ctx)
    except reviewgate.InputRefused as e:
        print(e, file=sys.stderr); sys.exit(5)
items, key = [], {}
for n, a in enumerate(args[1:]):
    name, _, trio = a.partition("=")
    parts = trio.split(":")
    if not name or len(parts) != 3: sys.exit(f"bad item: {a}")
    ref, old, new = parts
    order = [("old", old), ("new", new)]; random.shuffle(order)
    key[name] = {"X": order[0][0], "Y": order[1][0]}
    ims = [Image.open(p).convert("RGB") for p in (ref, order[0][1], order[1][1])]
    h = min(800, max(i.height for i in ims))
    ims = [i.resize((max(1, i.width * h // i.height), h)) for i in ims]
    W = sum(i.width for i in ims) + 24
    if W > 2100:
        s = 2100 / W; ims = [i.resize((int(i.width * s), int(i.height * s))) for i in ims]; h = ims[0].height
    im = Image.new("RGB", (sum(i.width for i in ims) + 24, h + 22), (30, 30, 30))
    d = ImageDraw.Draw(im); x = 0
    for lab, i in zip(("REFERENCE", "X", "Y"), ims):
        im.paste(i, (x, 22)); d.text((x + 4, 4), lab, fill=(255, 255, 255)); x += i.width + 12
    p = os.path.join(out, f"trio_{n}.png"); im.save(p); items.append((name, p))
json.dump(key, open(os.path.join(out, "key.json"), "w"), indent=1)

scope = ""
if stage:
    scope = (f"Judge ONLY this stage: {stage}." + (f" These belong to OTHER stages: {other}." if other else "")
             + " Ignore faults outside the stage.\n")
listing = "\n".join(f"- {name}: {p}" for name, p in items)
prompt = f"""You are a senior art director at a game studio comparing two candidate results against a reference.
You have no stake in either. {('What is shown: ' + ctx) if ctx else ''}
Each image below is one region: REFERENCE on the left, then candidates X and Y, same framing. Read every image with the
Read tool.
{listing}

For each region: list each candidate's faults against the REFERENCE, worst first, concretely, marking each MAJOR (a viewer
would notice at game distance or it changes what the thing is) or MINOR; then say which candidate is closer to the
reference in that region ("CLOSER: X", "CLOSER: Y" or "CLOSER: SAME") with one line why. Don't praise, don't guess at causes.
Say if a crop is too small or blurry to judge.
{scope}End with exactly one line per region in the form "REGION <name>: X|Y|SAME", then one final line
"OVERALL: X", "OVERALL: Y" or "OVERALL: SAME" (X and Y may be in a different order per region; judge each region alone)."""
if DRY:  # (Joe 2026-10-19) fallback when the CLI is refused: a fresh subagent gets ONE image per message
    open(os.path.join(out, "prompt.md"), "w").write(prompt + "\n\nFALLBACK REVIEW: give the reviewer ONE trio image per "
        "message, in the listed order; never a contact sheet. Collect its per-region lines, then the final line(s).\n")
    print(f"DRY: {out}/prompt.md + {len(items)} images (one per reviewer turn)"); sys.exit(0)
r = subprocess.run(["claude", "-p", prompt, "--allowedTools", "Read", "--tools", "Read", "--add-dir", out,
                    "--no-session-persistence", "--strict-mcp-config", "--setting-sources", "",
                    "--system-prompt", "You are a senior art director comparing renders against references. You have no "
                    "stake in this work.", "--output-format", "text"], cwd=out, capture_output=True, text=True, timeout=900)
text = r.stdout or ""
if r.returncode or "REGION" not in text:
    open(os.path.join(out, "review.md"), "w").write("REVIEW FAILED (claude exit %d)\n%s\n%s" % (r.returncode, text, r.stderr[-500:]))
    print("REVIEW FAILED"); sys.exit(4)
votes = {"old": 0, "new": 0}
lines = []
for name in key:
    m = re.search(r"REGION\s+" + re.escape(name) + r"\s*:\s*(X|Y|SAME)", text)
    v = m.group(1) if m else "?"
    who = key[name].get(v, "same" if v == "SAME" else "?")
    if who in votes: votes[who] += 1
    lines.append(f"{name}: {who.upper()}")
verdict = "NEW" if votes["new"] > votes["old"] else "OLD" if votes["old"] > votes["new"] else "TIE"
summary = "\n".join(["", "KEY APPLIED:"] + lines + [f"VERDICT: {verdict}"])
open(os.path.join(out, "review.md"), "w").write(text + "\n" + summary + "\n")
print(text + "\n" + summary)
sys.exit(0 if verdict == "NEW" else 3)
