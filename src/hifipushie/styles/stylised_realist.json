{
 "name": "stylised_realist",
 "about": "Feature-animation-lite humans (the disc golfer's reference, 2026-09-29): real proportions (~7 heads), a face built from five broad masses with a few pushed features (jaw/chin block, a low heavy brow mass, a dark iris clipped by both lids), everything small removed (nostril detail, wrinkles, pores, noise under 1 cm), and colour doing the modelling: saturated warm skin whose shadows turn redder, broad warm gradients on thin and occluded skin, solid designed shapes for brows and facial hair. For a GNM-headed base (the lm_* landmark joints address the paint). The written sheet with measured crops: workspace/character_renders/style_sheet.html.",
 "rules": {
  "chin_over_philtrum": [
   1.8,
   2.5
  ],
  "ala_width": [
   0.55,
   0.67
  ],
  "mouth_width": [
   0.85,
   1.05
  ],
  "eye_h_over_w": [
   0.33,
   0.5
  ],
  "iris_over_eye_w": [
   0.48,
   0.58
  ],
  "lid_cover_top": [
   0.12,
   0.3
  ],
  "lid_cover_bottom": [
   0.0,
   0.3
  ],
  "skin_sat_lit": [
   0.28,
   0.45
  ],
  "skin_sat_shadow": [
   0.45,
   0.65
  ],
  "skin_hue_shift_to_shadow": [
   3,
   12
  ],
  "_why": {
   "chin_over_philtrum": "mouth->chin over nose base->mouth. Band around the reference's own values: 1.84 measured on the far figure (nose outline, mouth line, chin outline, carried to 3D through the model), 2.3-2.9 read earlier from pixel landmarks on 3/4 views (+-10%); the two readings disagree, so the band spans both until a better view settles it",
   "mouth_width": "corner to corner over the interocular",
   "eye_h_over_w": "an open almond (reference 0.35 as drawn; GNM's lids measure ~0.1 over what reads: 0.31 measured read as sleepy/closed, 0.36-0.48 reads open)",
   "iris_over_eye_w": "a big dark iris: reference 0.52 (real ~0.39)",
   "lid_cover_top": "the upper lid covers ~20% of the iris: no white above it",
   "lid_cover_bottom": "the lower lid touches or covers the iris: no white below it",
   "skin_sat_lit": "HSV saturation of lit skin in the style's look (rendered, sampled on the forehead/cheek)",
   "skin_sat_shadow": "shadowed skin is MORE saturated than lit skin (reference ~0.6): not grey",
   "skin_hue_shift_to_shadow": "degrees the hue moves toward red from lit to shadow (reference ~7)",
   "corner_radius_cheekbone_mm": "the tightest turn of the horizontal section between the front and side planes at cheekbone height: a realistic GNM head ~42 mm",
   "muzzle_mm": "how far the upper lip stands in front of the cheeks beside the nose wings (GNM ~12: a muzzle). Not measurable in the reference's views (no profile); 0-10 keeps the style's flat-ish front without forbidding what a matched fit needs",
   "ala_width": "the nose across its outer alar wings over the interocular (base.ala_width). The reference measures 0.56 (near figure, matched camera) and 0.65 (far figure), each image ratio carried to 3D by the model's own 3D/image ratio in the same camera: a long, narrow nose. Replaces nose_width (GNM lm31-35, the nostril base inside the wings, which the reference can't show and which blocked narrowing the wings)",
   "eye_w_over_io": "eye corner to corner over the interocular, lid landmarks seen from the front (base.eye_size). Reference: 0.69 on the far figure's near-frontal eye (its turned eye 0.52), 0.49-0.55 on the near figure's 3/4 eyes: a big eye; GNM's mean ~0.5",
   "eye_h_over_io": "upper to lower lid margin over the interocular (base.eye_size). Reference 0.24 (far) and 0.22 (near): a tall, open opening. 0.18 read small, heavy-lidded and sleepy next to it"
  },
  "corner_radius_cheekbone_mm": [
   20,
   34
  ],
  "muzzle_mm": [
   0,
   10
  ],
  "eye_w_over_io": [
   0.55,
   0.72
  ],
  "eye_h_over_io": [
   0.2,
   0.27
  ]
 },
