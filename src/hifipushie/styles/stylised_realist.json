{
 "name": "stylised_realist",
 "about": "Feature-animation-lite humans (the disc golfer's reference, 2026-09-29): real proportions (~7 heads), a face built from five broad masses with a few pushed features (jaw/chin block, a low heavy brow mass, a dark iris clipped by both lids), everything small removed (nostril detail, wrinkles, pores, noise under 1 cm), and colour doing the modelling: saturated warm skin whose shadows turn redder, broad warm gradients on thin and occluded skin, solid designed shapes for brows and facial hair. For a GNM-headed base (the lm_* landmark joints address the paint). The written sheet with measured crops: workspace/character_renders/style_sheet.html.",
 "rules": {
  "chin_over_philtrum": [
   2.4,
   3.0
  ],
  "nose_width": [
   0.52,
   0.62
  ],
  "mouth_width": [
   0.85,
   1.05
  ],
  "eye_h_over_w": [
   0.3,
   0.37
  ],
  "iris_over_eye_w": [
   0.48,
   0.58
  ],
  "lid_cover_top": [
   0.12,
   0.3
  ],
  "lid_cover_bottom": [
   0.0,
   0.3
  ],
  "skin_sat_lit": [
   0.28,
   0.45
  ],
  "skin_sat_shadow": [
   0.45,
   0.65
  ],
  "skin_hue_shift_to_shadow": [
   3,
   12
  ],
  "_why": {
   "chin_over_philtrum": "mouth->chin over nose base->mouth: a short philtrum and a long, strong chin (reference 2.3-2.9; ~2.0 is realistic)",
   "nose_width": "nose wings over the interocular: one soft bulb, a touch wide",
   "mouth_width": "corner to corner over the interocular",
   "eye_h_over_w": "an almond, not a round (startled) eye: reference 0.35",
   "iris_over_eye_w": "a big dark iris: reference 0.52 (real ~0.39)",
   "lid_cover_top": "the upper lid covers ~20% of the iris: no white above it",
   "lid_cover_bottom": "the lower lid touches or covers the iris: no white below it",
   "skin_sat_lit": "HSV saturation of lit skin in the style's look (rendered, sampled on the forehead/cheek)",
   "skin_sat_shadow": "shadowed skin is MORE saturated than lit skin (reference ~0.6): not grey",
   "skin_hue_shift_to_shadow": "degrees the hue moves toward red from lit to shadow (reference ~7)"
  }
 },
