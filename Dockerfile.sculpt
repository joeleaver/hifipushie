# The HOSTED sculpt artist: hifipushie's oxidegen runner (hifipushie-artist --mode hosted) + Blender, on one
# rented GPU box per department session. Build with docker/build-sculpt.sh (it stages the asset packs first).
#
# Runtime env (set by the department): OXIDEGEN_URL, OXIDEGEN_RUNNER_TOKEN, OXIDEGEN_RUNNER_NAME,
# OXIDEGEN_RUNNER_MODE=hosted, NVIDIA_DRIVER_CAPABILITIES=all (graphics: the NVIDIA runtime injects the driver's
# EGL/GL libraries, which Blender's EEVEE uses headless); optional OXIDEGEN_WANTED_VERSION (+ OXIDEGEN_WANTED_REPO):
# a hifipushie git sha to run instead of the baked one. Nothing listens: the runner dials out.

ARG UBUNTU=ubuntu:24.04

# ------------------------------------------------------------------ Blender (official build, sha256-checked)
FROM ${UBUNTU} AS blender
ARG BLENDER_VERSION=5.1.2
ARG BLENDER_SERIES=5.1
ARG BLENDER_SHA256=aaccb355f50183979b698bcce7467103a76261b5fa59f4972295842662a285fb
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/blender.tar.xz \
      "https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}-linux-x64.tar.xz" \
 && echo "${BLENDER_SHA256}  /tmp/blender.tar.xz" | sha256sum -c - \
 && mkdir /opt/blender && tar -xJf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
 && rm /tmp/blender.tar.xz \
 # UI translations: never shown headless
 && rm -rf "/opt/blender/${BLENDER_SERIES}/datafiles/locale"

# ------------------------------------------------------------------ hifipushie (uv, from uv.lock)
FROM ${UBUNTU} AS app
COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_PREFERENCE=only-managed \
    UV_NO_CACHE=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version README.md ./
RUN uv python install && uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable && rm -rf /app/src

# ------------------------------------------------------------------ the runtime
FROM ${UBUNTU}
# Blender's own links (X11/xkb/GL dispatch) + EGL through glvnd: on an NVIDIA box the container runtime adds the
# driver's EGL vendor (graphics capability); Mesa's EGL is the software fallback (llvmpipe) so clay looks
# (Workbench) still render on a box without a usable GPU. fonts: contact-sheet labels.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libegl1 libgl1 libglvnd0 libglx0 libopengl0 libgles2 libegl-mesa0 libgl1-mesa-dri \
      libx11-6 libxext6 libxi6 libxfixes3 libxrender1 libxxf86vm1 libxkbcommon0 libsm6 libice6 libxcb1 \
      libxrandr2 libxcursor1 libxinerama1 libwayland-client0 libwayland-cursor0 libwayland-egl1 libdbus-1-3 \
      libuuid1 fonts-dejavu-core ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1001 --shell /usr/sbin/nologin sculpt \
 && mkdir -p /work && chown sculpt:sculpt /work
# uv + git: a box can start the department's pinned hifipushie sha (OXIDEGEN_WANTED_VERSION) over a copy of
# this venv (artist_update.hosted_update) without a new image
COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /usr/local/bin/uv
COPY --from=blender /opt/blender /opt/blender
COPY --from=app /opt/python /opt/python
COPY --from=app /app/.venv /app/.venv
COPY docker/assets /opt/hifipushie-assets
RUN ln -s /opt/blender/blender /usr/local/bin/blender \
 && HIFIPUSHIE_ASSETS=/opt/hifipushie-assets /app/.venv/bin/hifipushie-assets verify gnm makehuman
ARG GIT_SHA=""
ENV PATH=/app/.venv/bin:$PATH \
    HIFIPUSHIE_BLENDER=/opt/blender/blender \
    HIFIPUSHIE_ASSETS=/opt/hifipushie-assets \
    HIFIPUSHIE_ARTIST_WORK=/work \
    HIFIPUSHIE_GIT_SHA=${GIT_SHA} \
    OXIDEGEN_RUNNER_MODE=hosted \
    NVIDIA_DRIVER_CAPABILITIES=all \
    PYTHONUNBUFFERED=1
USER sculpt
WORKDIR /work
CMD ["hifipushie-artist"]
